<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SupportedOSPlatformVersion>0.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- TestRunner/ and UciEngine/ are standalone console projects (non-WASM):
       TestRunner runs perft/eval/search verification during development,
       UciEngine is the UCI front-end for external GUIs/bridges (e.g.
       lichess-bot). Neither must be globbed into this browser-wasm
       project's compilation. -->
  <ItemGroup>
    <Compile Remove="TestRunner/**/*.cs" />
    <Content Remove="TestRunner/**" />
    <None Remove="TestRunner/**" />
    <Compile Remove="UciEngine/**/*.cs" />
    <Content Remove="UciEngine/**" />
    <None Remove="UciEngine/**" />
  </ItemGroup>

</Project>
